{
  "name": "expense-track",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive:true}); fs.cpSync('frontend/dist', 'public', {recursive:true});\"",
    "start": "npm start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
